{
  "name": "openspec-viewer",
  "version": "0.5.0",
  "description": "Local web UI CLI to visualize and manage OpenSpec changes and tasks",
  "type": "module",
  "bin": {
    "openspec-viewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.js && tsc && node scripts/copy-ui.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warsclon/openspec-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/warsclon/openspec-viewer/issues"
  },
  "homepage": "https://github.com/warsclon/openspec-viewer#readme",
  "keywords": [
    "openspec",
    "cli",
    "viewer",
    "sdd",
    "spec-driven-development",
    "tasks"
  ],
  "author": "warsclon",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
