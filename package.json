{
  "name": "openspec-viewer",
  "version": "0.3.0",
  "description": "Local web UI to visualize and manage OpenSpec changes and tasks",
  "type": "module",
  "bin": {
    "openspec-viewer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ui.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "openspec",
    "cli",
    "viewer",
    "sdd"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
